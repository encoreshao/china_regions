# frozen_string_literal: true

appraise 'rails-5.2' do
  gem 'rails', '~> 5.2.0'
  gem 'sqlite3', '~> 1.4.0'
  # Newer nokogiri releases drop Ruby 2.6 support; this appraisal is the one
  # tested against Ruby 2.6, so pin to a version that still supports it.
  gem 'nokogiri', '< 1.15'
end

